{
  "name": "@pta/server",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --external:ws --outfile=dist/index.js --sourcemap",
    "start": "node dist/index.js",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@pta/shared": "0.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.12",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.1"
  }
}
