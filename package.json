{
  "name": "pokemon-tactical-arena",
  "private": true,
  "version": "0.1.0",
  "description": "Fan game táctico 5v5 en navegador con Pokémon. No oficial, sin monetización.",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "apps/client",
    "apps/server"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:client dev:server",
    "dev:client": "npm run dev --workspace apps/client",
    "dev:server": "npm run dev --workspace apps/server",
    "build": "npm run build --workspace apps/client && npm run build --workspace apps/server",
    "start": "npm run start --workspace apps/server",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p packages/shared && tsc --noEmit -p apps/server && tsc --noEmit -p apps/client",
    "lint": "eslint packages apps --ext .ts"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^8.57.0",
    "npm-run-all": "^4.1.5",
    "playwright": "^1.64.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  },
  "engines": {
    "node": ">=20"
  }
}
